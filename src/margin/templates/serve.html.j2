{#- The served page: the months with state and hash, the three actions, the log panel. Every value is
    escaped; the page loads nothing from outside and its one script is inline. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Account margin close</title>
<style>
  body { font: 16px/1.5 system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #1b1b1b; background: #fff; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: .25rem .5rem; border-bottom: 1px solid #ccc; vertical-align: top; }
  td.hash { font-family: ui-monospace, monospace; overflow-wrap: anywhere; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; min-height: 8rem; padding: .5rem; border: 1px solid #ccc; }
  button, select { font: inherit; padding: .25rem .75rem; margin: .25rem .25rem .25rem 0; }
  .notice { font-weight: bold; }
  a { color: #0b4f9c; }
  @media (prefers-color-scheme: dark) { body { color: #eee; background: #111; } th, td, pre { border-color: #444; } a { color: #8ab4f8; } }
</style>
</head>
<body>
<h1>Account margin close</h1>
<p>One close over the synthetic <code>mini</code> books. Run the next month's close, plant an error to watch a control name it, or reset the books.</p>

{% if notice %}<p class="notice" data-field="notice">{{ notice }}</p>
{% endif %}
<section id="months-panel">
<h2>Months</h2>
<table id="months">
<thead><tr><th>Month</th><th>State</th><th>Result hash</th></tr></thead>
<tbody>
{% for m in months %}<tr><td data-field="month">{{ m.month }}</td><td data-field="status">{{ m.status }}</td><td class="hash" data-field="result_hash">{{ m.result_hash or "-" }}</td></tr>
{% endfor %}</tbody>
</table>
</section>

<section id="actions">
<h2>Actions</h2>
<div id="close-control">
{% if next_month %}<button type="button" id="close-button" data-post="/close">Run the close for {{ next_month }}</button>
{% else %}<button type="button" id="close-button" data-post="/close" disabled>Run the close</button>
{% if all_closed %}<span data-field="all-closed">{{ all_closed_text }}</span>
{% endif %}{% endif %}
</div>
<div>
<label for="error">Plant an error</label>
<select id="error"{% if notice %} disabled{% endif %}>
{% for name in errors %}<option value="{{ name }}">{{ name }}</option>
{% endfor %}</select>
<button type="button" id="inject-button" data-post-from="error"{% if notice %} disabled{% endif %}>Plant it</button>
</div>
<div>
<button type="button" id="reset-button" data-post="/reset"{% if notice %} disabled{% endif %}>Reset</button>
</div>
</section>

<p id="memo">{% if memo_month %}<a id="memo-link" href="/site/{{ memo_month }}/index.html">Memo for {{ memo_month }}</a>{% endif %}</p>
<section id="result-panel" hidden>
<h2>Caught</h2>
<p id="caught" data-field="caught"></p>
<p id="caught-detail" data-field="caught-detail"></p>
<ul id="remediation"></ul>
</section>
<section id="log-panel">
<h2>Log</h2>
<pre id="log" aria-live="polite"></pre>
</section>

<script>
(function () {
  var log = document.getElementById("log");
  var busy = false;
  var seen = [];

  // While a stream is open every button is disabled; the ones the page had disabled stay so afterwards.
  function lock(on) {
    Array.prototype.forEach.call(document.querySelectorAll("button"), function (b) {
      if (on) { b.dataset.wasDisabled = b.disabled ? "1" : ""; b.disabled = true; }
      else if (b.dataset.wasDisabled !== undefined) { b.disabled = b.dataset.wasDisabled === "1"; }
    });
  }

  function append(line) {
    seen.push(line);
    log.textContent += line + "\n";
    log.scrollTop = log.scrollHeight;
  }

  // A planted error ends its stream with the control that caught it, what that control saw and the
  // remediation steps; the result panel shows those lines and the log keeps the whole stream.
  var result = { panel: document.getElementById("result-panel"), caught: document.getElementById("caught"),
                 detail: document.getElementById("caught-detail"), steps: document.getElementById("remediation") };

  function clearResult() {
    result.panel.hidden = true;
    result.caught.textContent = "";
    result.detail.textContent = "";
    result.steps.textContent = "";
  }

  function showResult(lines) {
    var at = -1;
    lines.forEach(function (line, i) { if (/^caught /.test(line)) { at = i; } });
    if (at < 0) { return; }
    result.caught.textContent = lines[at];
    var detail = [];
    lines.slice(at + 1).forEach(function (line) {
      if (line.indexOf("remediation: ") === 0) {
        var item = document.createElement("li");
        item.textContent = line.slice("remediation: ".length);
        result.steps.appendChild(item);
      } else {
        detail.push(line);
      }
    });
    result.detail.textContent = detail.join(" ");
    result.panel.hidden = false;
  }

  // The months table and the close button follow the warehouse: take them from a fresh copy of the page.
  function refresh() {
    return fetch("/", { cache: "no-store" }).then(function (res) { return res.text(); }).then(function (html) {
      var doc = new DOMParser().parseFromString(html, "text/html");
      ["months-panel", "close-control", "memo"].forEach(function (id) {
        var fresh = doc.getElementById(id), old = document.getElementById(id);
        if (fresh && old) { old.innerHTML = fresh.innerHTML; }
      });
    }).catch(function () {});
  }

  // Read the response body as it streams, one line at a time.
  function post(path) {
    if (busy) { return; }
    busy = true;
    lock(true);
    log.textContent = "";
    clearResult();
    seen = [];
    var pending = "";
    fetch(path, { method: "POST" }).then(function (res) {
      if (!res.ok) {
        return res.text().then(function (text) {
          var message = text;
          try { message = JSON.parse(text).message || text; } catch (e) {}
          append(message);
        });
      }
      var reader = res.body.getReader(), decoder = new TextDecoder();
      function pump() {
        return reader.read().then(function (chunk) {
          if (chunk.done) {
            if (pending) { append(pending); }
            return;
          }
          pending += decoder.decode(chunk.value, { stream: true });
          var lines = pending.split("\n");
          pending = lines.pop();
          lines.forEach(append);
          return pump();
        });
      }
      return pump();
    }).catch(function (err) {
      append("request failed: " + err);
    }).then(function () {
      if (path.indexOf("/inject/") === 0) { showResult(seen); }
      busy = false;
      lock(false);
      return refresh();
    });
  }

  document.addEventListener("click", function (event) {
    var button = event.target.closest("button");
    if (!button || button.disabled) { return; }
    if (button.dataset.post) { post(button.dataset.post); }
    else if (button.dataset.postFrom) { post("/inject/" + encodeURIComponent(document.getElementById(button.dataset.postFrom).value)); }
  });
})();
</script>
</body>
</html>
