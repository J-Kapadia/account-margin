{#- The exported page: the months, the recorded close, one panel per planted error. Every value is
    escaped, every link is relative, and the page has no script and loads nothing from outside. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Account margin close</title>
<style>
  body { font: 16px/1.5 system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #1b1b1b; background: #fff; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: .25rem .5rem; border-bottom: 1px solid #ccc; vertical-align: top; }
  td.hash { font-family: ui-monospace, monospace; overflow-wrap: anywhere; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; padding: .5rem; border: 1px solid #ccc; }
  section.panel { border: 1px solid #ccc; padding: 0 1rem; margin: 1rem 0; }
  a { color: #0b4f9c; }
  @media (prefers-color-scheme: dark) { body { color: #eee; background: #111; } th, td, pre, section.panel { border-color: #444; } a { color: #8ab4f8; } }
</style>
</head>
<body>
<h1>Account margin close</h1>
<p>One close over the synthetic <code>mini</code> books, recorded once. Below: the months, the close as it ran, what each planted error does to the books and the control that names it, and the memos.</p>

<section id="months-panel">
<h2>Months</h2>
<table id="months">
<thead><tr><th>Month</th><th>State</th><th>Result hash</th></tr></thead>
<tbody>
{% for m in months %}<tr><td data-field="month">{{ m.month }}</td><td data-field="status">{{ m.status }}</td><td class="hash" data-field="result_hash">{{ m.result_hash or "-" }}</td></tr>
{% endfor %}</tbody>
</table>
</section>

<section id="recorded-close">
<h2>Recorded close</h2>
{% if recorded %}<pre id="transcript">{{ transcript }}</pre>
<h3>Months after</h3>
<table id="months-after">
<thead><tr><th>Month</th><th>State</th><th>Result hash</th></tr></thead>
<tbody>
{% for m in recorded.months %}<tr><td data-field="month">{{ m.month }}</td><td data-field="status">{{ m.status }}</td><td class="hash" data-field="result_hash">{{ m.result_hash or "-" }}</td></tr>
{% endfor %}</tbody>
</table>
{% else %}<p data-field="all-closed">{{ all_closed_text }}</p>
{% endif %}</section>

<section id="planted-errors">
<h2>Planted errors</h2>
{% for p in panels %}<section class="panel" id="error-{{ p.error }}" data-error="{{ p.error }}">
<h3>{{ p.title }}</h3>
<p>{{ p.planted }}</p>
<p><strong data-field="caught">caught {{ p.control }}</strong></p>
<p>{{ p.caught }}</p>
<ol>
{% for step in p.remediation %}<li>{{ step }}</li>
{% endfor %}</ol>
</section>
{% endfor %}{% for line in skipped %}<p data-field="skipped">{{ line }}</p>
{% endfor %}</section>

<section id="memos">
<h2>Memos</h2>
<ul>
{% for month in memos %}<li><a href="site/{{ month }}/index.html">Memo for {{ month }}</a></li>
{% endfor %}</ul>
<p><a href="site/index.html">All memos</a></p>
</section>
</body>
</html>
